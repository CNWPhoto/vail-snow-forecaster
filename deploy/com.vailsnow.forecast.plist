<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd job for the Mac mini: build the forecast every morning. A template: deploy/install_schedule.sh installs it.
     Install all four with deploy/install_schedule.sh, which fills in the paths.
     10:45 am local time. The 12z HRRR run reaches the public copy about 9:30 am standard time and 10:30 am daylight time,
     so 10:45 works all season; the 12z ensemble (ready 10:30 am standard time) is in by then too. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.vailsnow.forecast</string>
  <key>WorkingDirectory</key><string>/PATH/TO/Vail Pinpoint Snow Forecaster</string>
  <key>ProgramArguments</key>
  <array><string>/opt/homebrew/bin/uv</string><string>run</string><string>vailsnow</string><string>forecast</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>45</integer></dict>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StandardOutPath</key><string>/PATH/TO/Vail Pinpoint Snow Forecaster/data/logs/forecast.log</string>
  <key>StandardErrorPath</key><string>/PATH/TO/Vail Pinpoint Snow Forecaster/data/logs/forecast.log</string>
</dict>
</plist>
